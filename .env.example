# Visionary OS Environment Variables
# Copy to .env and fill in your values

# ===========================================
# REQUIRED FOR AI FEATURES
# ===========================================

# Gemini API (Google AI)
# Get key: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace (AI Models)
# Get token: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_TOKEN=your_huggingface_token_here

# ===========================================
# OPTIONAL - FUTURE INTEGRATIONS
# ===========================================

# Backend API (when implemented)
# VITE_API_URL=https://api.redvisioncreativestudio.com

# Social Media APIs
# VITE_INSTAGRAM_ACCESS_TOKEN=
# VITE_TIKTOK_ACCESS_TOKEN=
# VITE_TWITTER_API_KEY=

# Music Platform APIs
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_CLIENT_SECRET=

# E-commerce
# VITE_STRIPE_PUBLIC_KEY=

# Analytics
# VITE_GOOGLE_ANALYTICS_ID=
